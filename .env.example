# Copy to .env and fill in. Any OpenAI-compatible endpoint works (pretrained models only, nothing is trained here).

# --- Option A: Groq (free tier, very fast) ---
EVENTMIND_BASE_URL=https://api.groq.com/openai/v1
EVENTMIND_API_KEY=your_groq_key_here
EVENTMIND_MODEL=llama-3.1-8b-instant

# --- Option B: local model with Ollama (counts for the small-model bonus) ---
# EVENTMIND_BASE_URL=http://localhost:11434/v1
# EVENTMIND_API_KEY=ollama
# EVENTMIND_MODEL=qwen2.5:7b

# --- Option C: Google Gemini OpenAI-compatible endpoint ---
# EVENTMIND_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EVENTMIND_API_KEY=your_gemini_key
# EVENTMIND_MODEL=gemini-2.0-flash-lite

# Set to 0 if your provider rejects response_format=json_object
EVENTMIND_JSON_MODE=1
